# 复制成 .env 后按需改，不填也能跑（会走默认值）
PORT=5173
# 生产环境务必换成随机串：openssl rand -hex 32
JWT_SECRET=
# 数据库路径，默认 ./data/app.db
DB_PATH=

# 运营模式
#   free   全站免费，登录即可看联系方式
#   manual 会员体系开启，但站上不发起支付：展示你的微信 → 用户私聊转账 → 后台确认开通
#   paid   线上支付，需要商户号与类目资质
# 演示付费墙就改成 manual 或 paid 重启（paid 目前是模拟支付）
MEMBER_MODE=free

# manual 模式下的收款信息（换成自己的）
PAY_WECHAT_ID=your_wechat_id
# 收款码图片路径，留空则只展示微信号
# PAY_QR=/assets/pay/qr.jpg
PAY_PAYEE_NAME=站长微信

# 发布权限：admin 只允许后台创建主页 / user 开放用户投稿（需审核）
PUBLISH_MODE=admin

# 站点对外地址，用于校验写请求来源；多个用逗号分隔
ALLOWED_ORIGINS=
# 走 HTTPS 时设 1
FORCE_HTTPS=0

# 是否生成 48 个演示主页，正式环境设 0
SEED_DEMO=1
